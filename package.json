{
    "name": "terrain-forge",
    "version": "0.1.0",
    "description": "Procedural terrain and level generator for indie game developers",
    "author": "Lorenzo",
    "license": "MIT",
    "main": "./out/main/index.js",
    "scripts": {
        "start": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "three": "^0.170.0",
        "tweakpane": "^4.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@tweakpane/core": "^2.0.5",
        "@types/node": "^22.9.0",
        "@types/three": "^0.170.0",
        "electron": "^44.1.1",
        "electron-vite": "^5.0.0",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.3.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.13.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.11"
    }
}
